# Optional defaults. The UI Settings page is the runtime config entry.
# Any OpenAI-compatible endpoint works: DeepSeek, Qwen, Groq, Moonshot, Ollama, OpenAI.

JOBHUNTER_PROVIDER=openai_compat
JOBHUNTER_BASE_URL=https://api.deepseek.com/v1
JOBHUNTER_API_KEY=
JOBHUNTER_MODEL=deepseek-chat
JOBHUNTER_TEMPERATURE=0.2
